DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID

# Only necessary if using Jellyfin, not needed for AudioBookShelf
JELLYFIN_SERVER=https://jellyfin.example.com/Sessions
JELLYFIN_API_KEY=YOUR_JELLYFIN_API_KEY
JELLYFIN_USER_ID=YOUR_JELLYFIN_USER_ID
TMDB_API_KEY=YOUR_TMDB_API_KEY

# optional, for jellyfin only:
JELLYFIN_IGNORE_LIBRARIES=Library1,Library2,Library3
DEFAULT_JELLYFIN_SERVER_NAME= Custom Server Name
USE_SERIES_IMAGE=False
# use TMDB posters instead of the Jellyfin cover images
USE_TMDB_IMAGE=False
# show the year the series started instead of the episode's year
GET_SHOW_YEAR=False
# prefix episode titles with their season and episode number, e.g. "S01E05 - Title"
FORCE_SHOW_EPISODE_INDEX=False
# show the series name in the top line instead of the episode title
SHOW_TITLE_IN_TOP=False

# Only necessary if using AudioBookShelf, not needed for Jellyfin
ABS_SERVER=https://abs.example.com
ABS_API_TOKEN=YOUR_ABS_API_TOKEN
# optional, for audiobookshelf only:
USE_CHAPTER_TITLE=true
# show progress within the current chapter instead of the whole book
USE_CHAPTER_TIMESTAMPS=False
DEFAULT_AUDIOBOOKSHELF_SERVER_NAME= Custom Server Name

# optional, for gateway connection only:
DISCORD_TOKEN=YOUR_DISCORD_TOKEN

# set to true to use gateway connection instead of rpc, requires discord user token and client id to be set
# defaults to false.
USE_GATEWAY=false

# optional, set to true to link the title and add buttons to public pages about what's playing (IMDb, TMDB, MusicBrainz, Audible, Open Library, Apple Podcasts)
# defaults to false.
USE_MEDIA_LINKS=false
# optional, up to 2 custom buttons shown on your presence (label max 32 characters, url must start with http:// or https://)
# custom buttons are shown before the media links
DISCORD_BUTTON_1_LABEL=
DISCORD_BUTTON_1_URL=
DISCORD_BUTTON_2_LABEL=
DISCORD_BUTTON_2_URL=

# Navidrome variables, only necessary if using Navidrome, not needed for Jellyfin or AudioBookShelf
NAVIDROME_USERNAME=admin
NAVIDROME_PASSWORD=adminpassword
NAVIDROME_SERVER=https://music.domain.tld
DEFAULT_NAVIDROME_SERVER_NAME=Navidrome
# Navidrome salt, should be a random string, used for hashing passwords, keep it secret
NAVIDROME_SALT=averygoodsaltthatshouldberandomandkeptsecret